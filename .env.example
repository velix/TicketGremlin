# TicketGremlin printer connection settings.
# Copy to .env and adjust. Env vars take precedence over the ini config file.

# "usb" or "network"
PRINTER_CONNECTION=network

# Printer IP on the LAN (set a DHCP reservation on your router for stability)
PRINTER_HOST=192.168.2.118

# Star ESC/POS raw TCP port (JetDirect)
PRINTER_PORT=9100
